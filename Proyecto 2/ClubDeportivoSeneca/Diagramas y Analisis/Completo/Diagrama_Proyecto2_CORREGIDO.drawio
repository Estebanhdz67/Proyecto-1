o : String, nombreCompetencia : String, rival : String, escenario : String) : PartidoCompetencia&lt;br&gt;+ registrarResultadoCompetencia(partidoCompetencia : PartidoCompetencia, marcador : String) : void&lt;br&gt;+ consultarCompetencias() : String&lt;br&gt;+ consultarInventario() : String&lt;br&gt;+ consultarHistorial() : String&lt;br&gt;+ generarReporteVentas() : String&lt;br&gt;+ generarReporteVentas(inicio : Date, fin : Date) : String&lt;br&gt;- estaEnPeriodo(fecha : Date, inicio : Date, fin : Date) : boolean&lt;br&gt;+ generarReporteDeportivo() : String&lt;br&gt;- generarReporteAsistencia() : String&lt;br&gt;- generarReporteResultados() : String&lt;br&gt;- generarReporteRankings() : String&lt;br&gt;- rankingVaAntes(ranking1 : Ranking, ranking2 : Ranking) : boolean&lt;br&gt;- textoResultado(resultado : String) : String&lt;br&gt;- nombresJugadores(jugadores : ArrayList&amp;lt;Socio&amp;gt;) : String&lt;br&gt;+ getSocio(idSocio : String) : Socio&lt;br&gt;+ getEmpleado(idEmpleado : String) : Empleado&lt;br&gt;+ getAdministrador(idAdministrador : String) : Administrador&lt;br&gt;+ getEquipo(nombre : String) : Equipo&lt;br&gt;+ getCompetencia(nombre : String) : Competencia&lt;br&gt;+ getDisciplina(nombre : String) : DisciplinaIndividual&lt;br&gt;+ getInstalacion(idInstalacion : String) : Instalacion&lt;br&gt;+ getProducto(nombre : String) : ProductoVenta&lt;br&gt;+ getArticulo(nombre : String) : ArticuloTienda&lt;br&gt;+ getUbicacion(nombre : String) : UbicacionInventario&lt;br&gt;+ escribirUsuarios() : void&lt;br&gt;+ escribirSerializable() : void&lt;br&gt;+ leerSerializable() : void&lt;br&gt;+ consultarUsuarios() : String&lt;br&gt;+ consultarEquipos() : String" vertex="1">
