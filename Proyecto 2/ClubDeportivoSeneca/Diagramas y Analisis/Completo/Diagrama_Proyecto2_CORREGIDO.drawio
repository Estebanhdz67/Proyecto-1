ombreConsola() : String&lt;br&gt;# puedeIngresar(usuario : Usuario) : boolean&lt;br&gt;# prepararSesion(usuario : Usuario) : void&lt;br&gt;# getOpcionesMenu() : String[]&lt;br&gt;# ejecutarOpcion(opcion : String) : void&lt;br&gt;- reporteVentas() : void&lt;br&gt;- crearSocio() : void&lt;br&gt;- crearEmpleado(entrenador : boolean) : void&lt;br&gt;- darBajaSocio() : void&lt;br&gt;- leerDeporteConjunto() : DeporteConjunto&lt;br&gt;- crearEquipo() : void&lt;br&gt;- inscribirJugador() : void&lt;br&gt;- darBajaEquipo() : void&lt;br&gt;- moverInventario() : void&lt;br&gt;- reabastecer() : void&lt;br&gt;- consultarProductos() : void&lt;br&gt;- revisarSugerencias() : void&lt;br&gt;- leerProductoNuevo() : ProductoVenta&lt;br&gt;- asignarTurno() : void&lt;br&gt;- verificarPersonal() : void&lt;br&gt;- revisarCambiosTurno() : void&lt;br&gt;- registrarMensualidad() : void&lt;br&gt;- crearTorneo() : void&lt;br&gt;- leerParticipante() : ParticipanteTorneo&lt;br&gt;- leerParticipanteIndividual() : ParticipanteTorneo&lt;br&gt;- buscarParticipanteIndividual(tipo : String) : ParticipanteTorneo&lt;br&gt;- leerInscrito(idTorneo : String, mensaje : String) : ParticipanteTorneo&lt;br&gt;- registrarParticipanteNoUsuario(estudiante : boolean) : void&lt;br&gt;- inscribirEnTorneo() : void&lt;br&gt;- retirarDeTorneo() : void&lt;br&gt;- programarEncuentro() : void&lt;br&gt;- registrarResultadoEncuentro() : void&lt;br&gt;- registrarPagoTorneo() : void&lt;br&gt;- consultarPremio() : void&lt;br&gt;- generarBono() : void&lt;br&gt;+ main(args : String[]) : void {static}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=14;strokeWidth=1.5;spacingTop=5;spacingLeft=7;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1123" y="1062" width="563" height="705" as="geometry" /></mxCell><mxCell id="p2-presentacion-11" value="&lt;b&gt;Socio&lt;/b&gt;&lt;br&gt;&lt;i&gt;(paquete logica)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=14;strokeWidth=1.5;spacingTop=5;spacingLeft=7;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="135.0" y="1907" width="168" height="54" as="geometry" /></mxCell><mxCell id="p2-presentacion-12" value="&lt;b&gt;Empleado&lt;/b&gt;&lt;br&gt;&lt;i&gt;(paquete logica)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=14;strokeWidth=1.5;spacingTop=5;spacingLeft=7;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="666.5" y="1907" width="168" height="54" as="geometry" /></mxCell><mxCell id="p2-presentacion-13" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;i&gt;(paquete logica)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=14;strokeWidth=1.5;spacingTop=5;spacingLeft=7;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="1284.5" y="1907" width="168" height="54" as="geometry" /></mxCell><mxCell id="p2-presentacion-14" value="&lt;b&gt;Cómo funciona la interfaz&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Cada tipo de usuario tiene su propio main: PrincipalSocio, PrincipalEmpleado y PrincipalAdministrador.&lt;br&gt;&lt;br&gt;2. ConsolaBase.ejecutar() define los pasos fijos: cargar datos, iniciar sesión, mostrar el menú y guardar al salir (patrón Template Method). Cada consola hija solo define sus opciones y qué hace cada una.&lt;br&gt;&lt;br&gt;3. Toda lectura de datos pasa por LectorConsola, que valida el formato y vuelve a preguntar si el dato está mal.&lt;br&gt;&lt;br&gt;4. Las consolas no tienen reglas de negocio: solo piden datos y llaman a ClubDeportivoSeneca. Si la lógica lanza una excepción, la consola muestra el motivo y vuelve al menú." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1806" y="1062" width="520" height="420" as="geometry" /></mxCell><mxCell id="p2-presentacion-15" value="«lanza»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.3;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-presentacion-2" target="p2-presentacion-3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeWidth=1.5;endSize=14;" edge="1" parent="1" source="p2-presentacion-3" target="p2-presentacion-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-17" value="lector 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.1;exitDx=0;exitDy=0;entryX=1;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-presentacion-5" target="p2-presentacion-2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-18" value="club 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.06;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-presentacion-5" target="p2-presentacion-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-19" value="«usa si no hay datos»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.3;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-presentacion-5" target="p2-presentacion-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-20" value="«carga datos en»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.3;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-presentacion-7" target="p2-presentacion-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeWidth=1.5;endSize=14;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-presentacion-8" target="p2-presentacion-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeWidth=1.5;endSize=14;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-presentacion-9" target="p2-presentacion-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeWidth=1.5;endSize=14;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-presentacion-10" target="p2-presentacion-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-24" value="socio 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-presentacion-8" target="p2-presentacion-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-25" value="empleado 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-presentacion-9" target="p2-presentacion-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-presentacion-26" value="administrador 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-presentacion-10" target="p2-presentacion-13"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p2-persistencia" name="10 Persistencia"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1352" pageHeight="844" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p2-persistencia-1" value="BLOQUE 10. PERSISTENCIA" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=22;strokeWidth=1.5;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="900" height="60" as="geometry" /></mxCell><mxCell id="p2-persistencia-2" value="&lt;b&gt;ClubDeportivoSeneca&lt;/b&gt;&lt;br&gt;&lt;i&gt;(paquete logica)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=14;strokeWidth=1.5;spacingTop=5;spacingLeft=7;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="192" height="54" as="geometry" /></mxCell><mxCell id="p2-persistencia-3" value="&lt;b&gt;ArchivoSerializable&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;&lt;b&gt;Métodos&lt;/b&gt;&lt;br&gt;+ escribir(objeto : Object, nombreArchivo : String) : void&lt;br&gt;+ leer(nombreArchivo : String) : Object" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=14;strokeWidth=1.5;spacingTop=5;spacingLeft=7;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="80" y="360" width="459" height="134" as="geometry" /></mxCell><mxCell id="p2-persistencia-4" value="&lt;b&gt;ArchivoPlano&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;&lt;b&gt;Métodos&lt;/b&gt;&lt;br&gt;+ escribir(nombreArchivo : String, datos : ArrayList&amp;lt;String&amp;gt;) : void&lt;br&gt;+ leer(nombreArchivo : String) : ArrayList&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=14;strokeWidth=1.5;spacingTop=5;spacingLeft=7;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="739" y="360" width="533" height="134" as="geometry" /></mxCell><mxCell id="p2-persistencia-5" value="&lt;b&gt;Archivos en la carpeta datos/&lt;/b&gt;&lt;br&gt;&lt;br&gt;• clubDeportivoSeneca.bin: todo el estado del club, guardado con serialización (ArchivoSerializable).&lt;br&gt;• usuarios.csv: lista de usuarios en texto plano (ArchivoPlano).&lt;br&gt;&lt;br&gt;Las consolas llaman a leerSerializable() al iniciar y a escribirSerializable() y escribirUsuarios() al salir." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="574" width="760" height="190" as="geometry" /></mxCell><mxCell id="p2-persistencia-6" value="archivoSerializable 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-persistencia-2" target="p2-persistencia-3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-persistencia-7" value="archivoPlano 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-persistencia-2" target="p2-persistencia-4"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>