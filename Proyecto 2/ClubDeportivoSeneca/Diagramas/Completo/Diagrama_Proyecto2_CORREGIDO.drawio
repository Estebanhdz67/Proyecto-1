        <mxCell id="seneca" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=14;strokeWidth=1.5;spacingTop=8;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;ClubDeportivoSeneca&lt;/b&gt;&lt;hr&gt;- usuarios : HashMap&amp;lt;String, Usuario&amp;gt;&lt;br&gt;- socios : HashMap&amp;lt;String, Socio&amp;gt;&lt;br&gt;- empleados : HashMap&amp;lt;String, Empleado&amp;gt;&lt;br&gt;- administradores : HashMap&amp;lt;String, Administrador&amp;gt;&lt;br&gt;- equipos : HashMap&amp;lt;String, Equipo&amp;gt;&lt;br&gt;- competencias : HashMap&amp;lt;String, Competencia&amp;gt;&lt;br&gt;- torneos : HashMap&amp;lt;String, Torneo&amp;gt;&lt;br&gt;- disciplinas : HashMap&amp;lt;String, DisciplinaIndividual&amp;gt;&lt;br&gt;- instalaciones : HashMap&amp;lt;String, Instalacion&amp;gt;&lt;br&gt;- productos : HashMap&amp;lt;String, ProductoVenta&amp;gt;&lt;br&gt;- ubicaciones : HashMap&amp;lt;String, UbicacionInventario&amp;gt;&lt;br&gt;- ventas : ArrayList&amp;lt;Venta&amp;gt;&lt;br&gt;- reservas : ArrayList&amp;lt;Reserva&amp;gt;&lt;br&gt;- partidosPractica : ArrayList&amp;lt;PartidoPractica&amp;gt;&lt;br&gt;- partidosInternos : ArrayList&amp;lt;PartidoInterno&amp;gt;&lt;br&gt;- partidosCompetencia : ArrayList&amp;lt;PartidoCompetencia&amp;gt;&lt;br&gt;- sesiones : ArrayList&amp;lt;SesionEntrenamiento&amp;gt;&lt;br&gt;- existencias : ArrayList&amp;lt;ExistenciaInventario&amp;gt;&lt;br&gt;- movimientos : ArrayList&amp;lt;MovimientoInventario&amp;gt;&lt;br&gt;- reabastecimientos : ArrayList&amp;lt;Reabastecimiento&amp;gt;&lt;br&gt;- solicitudes : ArrayList&amp;lt;SolicitudCambioTurno&amp;gt;&lt;br&gt;- sugerencias : ArrayList&amp;lt;SugerenciaProducto&amp;gt;&lt;br&gt;- archivoPlano : ArchivoPlano&lt;br&gt;- archivoSerializable : ArchivoSerializable&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;- usuarioActual : Usuario&lt;/span&gt;&lt;div&gt