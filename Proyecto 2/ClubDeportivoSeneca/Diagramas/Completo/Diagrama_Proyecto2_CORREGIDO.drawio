ipo) : void&lt;br&gt;+ registrarAsistencia(sesion : SesionEntrenamiento, idSocio : String, estado : String) : void&lt;br&gt;+ registrarEvaluacion(sesion : SesionEntrenamiento, idSocio : String, nota : double, comentario : String) : void&lt;br&gt;+ programarPartidoInterno(fecha : Date, local : String, visitante : String) : PartidoInterno&lt;br&gt;+ registrarEstadisticaFutbol(partidoInterno : Partido, socio : Socio, goles : int, asistencias : int, amarillas : int, rojas : int) : void&lt;br&gt;+ registrarEstadisticaBaloncesto(partido : Partido, socio : Socio, puntos : int, rebotes : int) : void&lt;br&gt;+ registrarEstadisticaVoleibol(partido : Partido, socio : Socio, aces : int, bloqueos : int) : void&lt;br&gt;+ crearCompetencia(nombre : String, entidad : String, temporada : String, deporte : DeporteConjunto, categoria : String, formato : FormatoCompetencia) : Competencia&lt;br&gt;+ inscribirEquipoCompetencia(competencia : String, equipo : String, nomina : ArrayList&amp;lt;Socio&amp;gt;) : InscripcionCompetencia&lt;br&gt;+ agregarProducto(producto : ProductoVenta) : void&lt;br&gt;+ agregarUbicacion(ubicacion : UbicacionInventario) : void&lt;br&gt;+ crearExistencia(articulo : String, ubicacion : String, cantidad : int) : ExistenciaInventario&lt;br&gt;+ buscarExistencia(articulo : String, ubicacion : String) : ExistenciaInventario&lt;br&gt;+ moverInventario(articulo : String, origen : String, destino : String, cantidad : int, idAdmin : String) : MovimientoInventario&lt;br&gt;+ reabastecer(articulo : String, ubicacion : String, cantidad : int, idAdmin : String) : Reabastecimiento&lt;br&gt;+ registrarVentaTienda(comprador : String, ubicacion : String, HashMap&amp;lt;String, cantidades : Integer&amp;gt;, codigo : String, puntos : int) : VentaTienda&lt;br&gt;+ registrarVentaCafeteria(comprador : String, HashMap&amp;lt;String, cantidades : Integer&amp;gt;, porcentajePropina : double, puntos : int) : VentaCafeteria&lt;br&gt;+ asignarTurno(idEmpleado : String, dia : String, inicio : Time, fin : Time) : Turno&lt;br&gt;+ solicitarCambio(idEmpleado : String, actual : Turno, nuevo : Turno) : SolicitudCambioTurno&lt;br&gt;+ revisarCambio(solicitud : SolicitudCambioTurno, idAdmin : String, aprobar : boolean) : void&lt;br&gt;+ cumpleMinimoPersonal() : boolean&lt;br&gt;+ sugerirProducto(idEmpleado : String, descripcion : String) : SugerenciaProducto&lt;br&gt;+ revisarSugerencia(sugerenciaProducto : SugerenciaProducto, idAdmin : String, aprobar : boolean, producto : ProductoVenta) : void&lt;br&gt;+ registrarMensualidad(idSocio : String, mes : String, valor : double, fecha : Date) : void&lt;br&gt;+ escribirUsuarios() : void&lt;br&gt;+ escribirSerializable() : void&lt;br&gt;+ leerSerializable() : void&lt;br&gt;+ consultarUsuarios() : String&lt;br&gt;+ consultarEquipos() : String&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;+ cerrarSesion() : void&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;+ getUsuarioActual() : Usuario&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;+ darBajaSocio(idSocio : String) : void&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;+ darBajaEquipo(nombreEquipo : String) : void&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;+ consultarEquiposSocio(idSocio : String) : String&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;+ consultarTurnos(idEmpleado : String) : String&lt;/span&gt;&lt;/div&gt;&lt;di